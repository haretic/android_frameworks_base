<!-- The apps pinned to the power menu, under the buttons inside the menu's card -->
<com.android.systemui.globalactions.PowerMenuPinnedApps
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/global_actions_pinned"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/global_actions_pinned_divider_margin"
        android:layout_marginBottom="@dimen/global_actions_pinned_divider_margin"
        android:background="@color/materialColorOutlineVariant" />

    <TextView
        style="@style/GlobalActionsStats.Label"
        android:layout_marginBottom="@dimen/global_actions_pinned_label_margin"
        android:text="@string/global_actions_pinned_title" />

    <LinearLayout
        android:id="@+id/global_actions_pinned_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical" />
</com.android.systemui.globalactions.PowerMenuPinnedApps>
