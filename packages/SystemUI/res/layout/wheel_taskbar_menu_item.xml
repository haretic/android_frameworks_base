<!-- A row of a wheel taskbar list: a recent app or a favourite. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/wheel_taskbar_item_height"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/wheel_taskbar_item_icon"
        android:layout_width="@dimen/wheel_taskbar_item_icon"
        android:layout_height="@dimen/wheel_taskbar_item_icon"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wheel_taskbar_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.WheelTaskbar.Item" />

        <TextView
            android:id="@+id/wheel_taskbar_item_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.WheelTaskbar.Summary" />
    </LinearLayout>
</LinearLayout>
