<!-- Power menu stats: CPU, temperature, battery and RAM side by side, as a card above the
     menu in portrait and a strip along the top edge in landscape (the cell layout and the
     background differ). Nothing in it can take the focus. -->
<com.android.systemui.globalactions.PowerMenuStatsPanel
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/global_actions_stats"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/global_actions_stats_background"
    android:paddingHorizontal="@dimen/global_actions_stats_padding_horizontal"
    android:paddingVertical="@dimen/global_actions_stats_padding_vertical"
    android:translationZ="@dimen/global_actions_translate"
    android:orientation="horizontal"
    android:gravity="center"
    android:baselineAligned="false"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:descendantFocusability="blocksDescendants"
    android:contentDescription="@string/global_actions_stats_description">

    <include
        android:id="@+id/global_actions_stats_cpu"
        layout="@layout/global_actions_stats_cell" />

    <include
        android:id="@+id/global_actions_stats_temp"
        layout="@layout/global_actions_stats_cell" />

    <include
        android:id="@+id/global_actions_stats_bat"
        layout="@layout/global_actions_stats_cell" />

    <include
        android:id="@+id/global_actions_stats_ram"
        layout="@layout/global_actions_stats_cell" />

</com.android.systemui.globalactions.PowerMenuStatsPanel>
