<!-- One pinned app: its icon with its name under it -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/global_actions_pinned_item_width"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/global_actions_pinned_item_padding"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/global_actions_pinned_item_background"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/global_actions_pinned_icon"
        android:layout_width="@dimen/global_actions_pinned_icon_size"
        android:layout_height="@dimen/global_actions_pinned_icon_size"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/global_actions_pinned_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/global_actions_pinned_label_gap"
        android:gravity="center_horizontal"
        android:singleLine="true"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:fontFamily="@*android:string/config_bodyFontFamilyMedium"
        android:textSize="@dimen/global_actions_pinned_label_size"
        android:textColor="@color/materialColorOnSurface" />
</LinearLayout>
