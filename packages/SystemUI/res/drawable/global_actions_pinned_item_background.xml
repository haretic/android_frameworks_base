<!-- Pressed state of a pinned app, and a ring while it has the focus, like the buttons -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="@dimen/global_actions_focus_ring_width"
                        android:color="@color/materialColorOnSurface" />
                    <corners android:radius="@dimen/global_actions_pinned_item_corner_radius" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/global_actions_pinned_item_corner_radius" />
        </shape>
    </item>
</ripple>
