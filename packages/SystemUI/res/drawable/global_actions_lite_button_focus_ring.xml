<!-- Ring around a power menu button while it has the focus, so the scroll wheel always shows
     where it is. A foreground, so the emergency button's background tint leaves it alone. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <stroke
                android:width="@dimen/global_actions_focus_ring_width"
                android:color="@color/materialColorOnSurface" />
        </shape>
    </item>
</selector>
